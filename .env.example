# ── 디스코드 ──────────────────────────────
DISCORD_TOKEN=
CLIENT_ID=
# (선택) 개발 서버 ID — 명령어가 그 서버에 즉시 반영됨. 비우면 전역 등록
DEV_GUILD_ID=
# true면 봇 부팅 시 슬래시 명령어 자동 등록 (Koyeb 권장)
REGISTER_COMMANDS=true

# ── MongoDB Atlas ─────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/casino?retryWrites=true&w=majority

# ── 경제 ──────────────────────────────────
# guild = 서버마다 독립 지갑(기본) / global = 모든 서버 공용 지갑
ECONOMY_SCOPE=guild
# 부팅 시 이전 프로세스의 판 즉시 복구 (단일 인스턴스 전제, 기본 true)
RECOVER_ON_BOOT=true

# ── 운영 ──────────────────────────────────
# 쉼표로 구분한 봇 소유자 디스코드 ID (모든 서버에서 /관리자 사용 가능)
BOT_OWNER_IDS=
# 장애 알림을 받을 디스코드 웹훅 URL (채널 설정 → 연동 → 웹후크)
ALERT_WEBHOOK_URL=
# 웹 대시보드 접근 토큰 (비우면 /dashboard 비활성). 길고 무작위인 값 사용
DASHBOARD_TOKEN=

# ── Koyeb 헬스 체크 포트 ──────────────────
PORT=8000
